# Copy to .env.local and fill in. Both values are safe to ship to the browser:
# the anon key only grants what the RLS policies and RPCs in supabase/migrations allow.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# The YouTube Data API key is NOT set here. It lives only in the Edge Function:
#   supabase secrets set YOUTUBE_API_KEY=...
